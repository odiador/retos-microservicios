pipeline {
    agent any

    tools {
        nodejs "nodeForAuth"
    }

    environment {
        SONAR_URL = "http://sonarqube:9000"
        SONAR_USER = "admin"
        SONAR_PASS = "admin"
        TOKEN_FILE = "sonar_token.txt"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'automatizacion-04', url: 'https://github.com/odiador/retos-microservicios.git'
            }
        }

        stage('Generate SonarQube Token') {
            steps {
                script {
                    echo "⏳ Esperando que SonarQube esté listo..."
                    sh '''
                    until curl -s $SONAR_URL/api/system/health | grep -q '"health":"GREEN"'; do
                        echo "Esperando SonarQube..."
                        sleep 5
                    done
                    echo "✅ SonarQube está listo."
                    '''

                    echo "🔑 Generando token..."
                    sh '''
                    RESPONSE=$(curl -s -u $SONAR_USER:$SONAR_PASS \
                      -X POST "$SONAR_URL/api/user_tokens/generate" \
                      -d "name=jenkins-auto-$(date +%s)")
                    echo $RESPONSE | jq -r '.token' > $TOKEN_FILE
                    TOKEN=$(cat $TOKEN_FILE)
                    echo "Token generado correctamente."
                    '''

                    // Cargar token en variable del pipeline
                    env.SONAR_AUTH_TOKEN = sh(script: "cat $TOKEN_FILE", returnStdout: true).trim()
                }
            }
        }

        stage('Install dependencies') {
            steps {
                sh 'pwd'
                echo "==========================================="
                echo "📦 Instalando dependencias de Node.js..."
                echo "==========================================="
                sh 'node --version'
                sh 'npm --version'
                dir('auth') {
                    sh 'npm install'
                }
            }
        }

        stage('Run tests') {
            steps {
                sh 'npm test || echo "Tests skipped"' // opcional si aún no tienes tests
            }
        }

        stage('SonarQube Analysis') {
            // environment {
            //     SONAR_HOST_URL = "http://sonarqube:9000"
            //     SONAR_AUTH_TOKEN = credentials('sonarqube-token')
            // }
            steps {
                script {
                    // def scannerHome = tool 'sonarqube'
                    withSonarQubeEnv('sonarqube') {
                        dir('auth') {
                            sh """
                                echo "🔍 Ejecutando análisis SonarQube..."
                                ${scannerHome}/bin/sonar-scanner \
                                    -Dsonar.projectKey=auth-service \
                                    -Dsonar.projectName=auth-service \
                                    -Dsonar.sources=. \
                                    -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                                    -Dsonar.host.url=$SONAR_URL \
                                    -Dsonar.login=$SONAR_AUTH_TOKEN
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 1, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}