pipeline {
    agent any

    tools {
        nodejs "nodeForAuth"
    }

    environment {
        SONAR_URL = "http://sonarqube:9000"
        SONAR_USER = "admin"
        SONAR_PASS = "admin"
        TOKEN_FILE = "sonar_token.txt"
    }

    stages {
        stage('🔍 Checkout') {
            steps {
                echo "==========================================="
                echo "📥 Clonando repositorio..."
                echo "==========================================="
                git branch: 'automatizacion-04', url: 'https://github.com/odiador/retos-microservicios.git'
            }
        }

    // El stage para generar un token en SonarQube se ha eliminado porque
    // el token ya se gestiona desde la UI de Jenkins (Credentials).
    // Si necesitas regenerarlo desde pipeline, podemos volver a añadir
    // la lógica aquí, pero no es necesario cuando la credencial existe.

        stage('📦 Install dependencies') {
            steps {
                sh 'pwd'
                echo "==========================================="
                echo "📦 Instalando dependencias de Node.js..."
                echo "==========================================="
                sh 'node --version'
                sh 'npm --version'
                dir('auth') {
                    sh 'npm install'
                }
            }
        }

        stage('🧪 Run tests') {
            steps {
                echo "==========================================="
                echo "🧪 Ejecutando pruebas unitarias..."
                echo "==========================================="
                sh 'npm test || echo "Tests skipped"' // opcional si aún no tienes tests
            }
        }

        stage('🔍 SonarQube Analysis') {
            environment {
                // Usar la credencial creada en la UI de Jenkins (id: 'sonarqube-token')
                SONAR_AUTH_TOKEN = credentials('sonarqube-token')
            }
            steps {

                echo "==========================================="
                echo "🔍 Analizando calidad de código con SonarQube..."
                echo "==========================================="

                script {
                    // Obtener la instalación del scanner configurada en Jenkins (nombre: 'sonar-scanner')
                    // Ajusta el nombre si en tu Jenkins el tool tiene otro id.
                    def scannerHome = tool 'sonar-scanner'

                    withSonarQubeEnv('sonarqube') {
                        dir('auth') {
                            sh """
                                echo "🔍 Ejecutando análisis SonarQube..."
                                ${scannerHome}/bin/sonar-scanner \
                                    -Dsonar.projectKey=auth-service \
                                    -Dsonar.projectName=auth-service \
                                    -Dsonar.sources=. \
                                    -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                                    -Dsonar.host.url=$SONAR_URL \
                                    -Dsonar.login=${SONAR_AUTH_TOKEN}
                            """
                        }
                    }
                }
            }
        }

        stage('🚦 Quality Gate') {
            steps {
                echo "==========================================="
                echo "🚦 Verificando Quality Gate de SonarQube..."
                echo "==========================================="

                timeout(time: 1, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}