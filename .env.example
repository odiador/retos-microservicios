# Ejemplo de archivo .env
# Copia este archivo como .env en la raíz del proyecto

# === BASE DE DATOS ===
DB_NAME=microservicios
DB_USER=postgres
DB_PASS=postgres123
DB_SCHEMA=auth

# === JWT AUTHENTICATION ===
JWT_SECRET=mi_secreto_super_seguro_para_jwt_cambiar_en_produccion
TOKEN_EXP=1h

# === TWILIO (Opcional) ===
# Si no se configuran, los SMS solo se loggean
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=tu_auth_token_aqui
# TWILIO_PHONE_NUMBER=+1234567890

# === RABBITMQ ===
# Configuración de RabbitMQ con variables de entorno
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=securepass
RABBITMQ_VHOST=/
AUTH_EVENTS_EXCHANGE=auth.events
ORCHESTRATOR_QUEUE=orchestrator.queue
MESSAGING_EMAIL_QUEUE=messaging.email.queue
MESSAGING_SMS_QUEUE=messaging.sms.queue
AUTH_AUDIT_QUEUE=auth.audit.queue
USER_ROUTING_KEY=user.*
PASSWORD_ROUTING_KEY=password.*
SEND_EMAIL_ROUTING_KEY=send.email
SEND_SMS_ROUTING_KEY=send.sms

# URL de conexión (para compatibilidad)
RABBITMQ_URL=amqp://admin:securepass@rabbitmq:5672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=securepass

# === ORCHESTRATOR (Spring Boot) ===
# Configuración del servicio orquestador
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
SERVER_PORT=8080
LOG_LEVEL_ORCHESTRATOR=INFO
LOG_LEVEL_SPRING_AMQP=WARN
LOG_LEVEL_ROOT=INFO

# === PUERTOS ===
# Los puertos están definidos en docker-compose.yml
# AUTH_PORT=3500
# MESSAGING_PORT=6379
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# DB_PORT=5432
